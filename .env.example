# Supabase project settings (Project Settings -> API Keys in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
# New-format public key (sb_publishable_...). Takes precedence over the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon JWT - fallback until Supabase disables legacy keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key: server-only, bypasses RLS. Never expose to the browser.
# New format is sb_secret_...; SUPABASE_SERVICE_ROLE_KEY is the legacy fallback.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com) - transactional email
RESEND_API_KEY=
# Must be a verified sender/domain in Resend, e.g. "Billing <billing@yourdomain.com>"
RESEND_FROM_EMAIL=

# Shared secret required by the Netlify scheduled function to call the cron API route (if used)
CRON_SECRET=

# Public URL of the deployed app, used in email links (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
